# Copy to keystore.properties (untracked) to sign release builds.
# Without this file the release build is produced unsigned.
#
# Create an upload key once:
#   keytool -genkeypair -v -keystore chessomnia-upload.jks \
#           -alias upload -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks file OUTSIDE the repository and back it up: losing it means
# losing the ability to publish updates under the same listing.
storeFile=/absolute/path/to/chessomnia-upload.jks
storePassword=
keyAlias=upload
keyPassword=
