<?xml version="1.0" encoding="utf-8"?>
<!--
  Start or resume the clock.
  Own work, Apache-2.0. Drawn on a 24x24 grid with a 2dp stroke and round
  caps, so the whole set reads as one hand.
  No android:tint here: Compose's Icon() applies the colour via a filter,
  which lets the button follow the panel's colour role.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12 3.2 A8.8 8.8 0 1 1 11.99 3.2"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path android:pathData="M10 8.4 L16.4 12 L10 15.6 Z" android:fillColor="#FF000000" />
</vector>
