<?xml version="1.0" encoding="utf-8"?>
<!--
  Start a new game. A restart arrow: begin again from the initial position.
  Own work, Apache-2.0. Drawn on a 24x24 grid with a 2dp stroke and round
  caps, so the whole set reads as one hand.
  No android:tint here: Compose's Icon() applies the colour via a filter,
  which lets the button follow the panel's colour role.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M19.10 7.90 A8.2 8.2 0 1 1 6.73 5.72"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path android:pathData="M9.49 3.40 L7.77 8.51 L4.16 4.21 Z" android:fillColor="#FF000000" />
</vector>
