<?xml version="1.0" encoding="utf-8"?>
<!--
  Back to the main menu. This does not end the game.
  Own work, Apache-2.0. Drawn on a 24x24 grid with a 2dp stroke and round
  caps, so the whole set reads as one hand.
  No android:tint here: Compose's Icon() applies the colour via a filter,
  which lets the button follow the panel's colour role.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M3.2 11.2 L12 4 L20.8 11.2"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M5.8 9.1 V20.2 H18.2 V9.1"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M9.8 20.2 V14.4 H14.2 V20.2"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
