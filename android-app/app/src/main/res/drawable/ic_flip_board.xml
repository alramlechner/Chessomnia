<?xml version="1.0" encoding="utf-8"?>
<!--
  Turn the board by 180 degrees, so nobody has to lift the tablet.
  Own work, Apache-2.0. Drawn on a 24x24 grid with a 2dp stroke and round
  caps, so the whole set reads as one hand.
  No android:tint here: Compose's Icon() applies the colour via a filter,
  which lets the button follow the panel's colour role.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M4.8 9.6 A7.5 7.5 0 0 1 18.8 8.2"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M19.2 4.4 V8.6 H15"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M19.2 14.4 A7.5 7.5 0 0 1 5.2 15.8"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M4.8 19.6 V15.4 H9"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
