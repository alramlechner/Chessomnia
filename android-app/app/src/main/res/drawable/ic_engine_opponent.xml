<?xml version="1.0" encoding="utf-8"?>
<!--
  This side is played by the device: a CPU chip, so it reads as "computer" at
  a glance. Replaces the earlier hand-drawn brain-and-circuit motif with the
  "icon-computer-simple" variant supplied for this exact size class (badges,
  20 to 36dp); see the accompanying readme for the medium/detail variants
  meant for larger UI.
  No android:tint here: Compose's Icon() applies the colour via a filter,
  which lets the icon follow the panel's colour role.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
